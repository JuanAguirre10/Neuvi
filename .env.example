# Conexión a PostgreSQL. En Vercel, la integración de Neon crea ambas variables.
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/neuvi?schema=public"
DATABASE_URL_UNPOOLED="postgresql://postgres:TU_PASSWORD@localhost:5432/neuvi?schema=public"

# Secreto para firmar la cookie de sesión (mínimo 32 caracteres).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# WhatsApp de contacto/ventas de Neuvi (código de país + número, sin '+').
NEXT_PUBLIC_NEUVI_WHATSAPP="51972540056"
